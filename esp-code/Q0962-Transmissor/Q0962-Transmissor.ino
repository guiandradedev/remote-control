/*
 * ===== TABELA DE COMANDOS =====
 * Para cada sinal colado acima, adicione uma linha: COMANDO(sinal_N)
 * A posição na tabela é o número digitado no Serial.
 */
struct Comando {
    const uint16_t *sinal;
    uint16_t tamanho;
};

#define COMANDO(nome) {nome, sizeof(nome) / sizeof(nome[0])}

const Comando comandos[] = {
    COMANDO(sinal_0),
    COMANDO(sinal_1),
    // COMANDO(sinal_2),
};

const uint8_t NUMERO_COMANDOS = sizeof(comandos) / sizeof(comandos[0]);

void setup() {
    Serial.begin(115200);
    delay(500);

    IrSender.begin(IR_SEND_PIN);

    Serial.print(F("Transmissor IR pronto. Comandos disponiveis: 0 a "));
    Serial.println(NUMERO_COMANDOS - 1);
}

void loop() {
    if (Serial.available()) {
        char recebido = Serial.read();

        // Ignora o Enter do Serial Monitor
        if (recebido == '\n' || recebido == '\r') {
            return;
        }

        if (recebido >= '0' && recebido <= '9') {
            uint8_t indice = recebido - '0';

            if (indice < NUMERO_COMANDOS) {
                Serial.print(F("Enviando comando "));
                Serial.println(indice);
                IrSender.sendRaw(comandos[indice].sinal, comandos[indice].tamanho, FREQUENCIA_IR_KHZ);
            } else {
                Serial.print(F("Comando "));
                Serial.print(indice);
                Serial.println(F(" nao cadastrado."));
            }
        } else {
            Serial.println(F("Digite um numero entre 0 e 9."));
        }
    }
}
